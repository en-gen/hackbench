// Type-checks the provider tests and the `vscode` stub they run against.
//
// The repo-wide `tsc --noEmit` covers src/ only, and the wider test tree still
// carries the type errors tracked as issue #316, so a whole-tree check would be
// red on arrival. Scoped here, the stub's `import type * as vscode` earns its
// keep: an @types/vscode signature change breaks this build instead of leaving
// the tests asserting a shape VS Code no longer has.
//
// L2EntrancesRequired.synthetic.test.ts is the one unit test listed: its @ts-expect-error is the
// compile-time proof that buildL2Inputs requires `entrances` (#1340).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "types": ["node", "vscode"]
  },
  "include": ["test/suite/provider/**/*.ts", "test/suite/support/vscodeStub.ts", "test/suite/unit/L2EntrancesRequired.synthetic.test.ts"]
}
