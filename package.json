{
  "name": "hackbench",
  "displayName": "HackBench",
  "description": "Super Mario World ROM editor. The application is the Theia desktop app under theia/.",
  "version": "0.1.0",
  "author": "Brian Engen",
  "license": "MIT",
  "private": true,
  "//": "The vscode engine, main, activationEvents and contributes fields are NOT a shipping target. They belong to the original VS Code extension in src/providers/ and src/webview/, which is kept as a reference implementation for reading SMW data and is still built by npm run compile. HackBench is not published to the Marketplace, so the publisher, categories and icon fields that asserted otherwise are gone. See docs/architecture/overview.md.",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/en-gen/hackbench"
  },
  "bugs": {
    "url": "https://github.com/en-gen/hackbench/issues"
  },
  "homepage": "https://github.com/en-gen/hackbench#readme",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "hackbench.openRom",
        "title": "Open ROM…",
        "category": "HackBench"
      },
      {
        "command": "hackbench.closeRom",
        "title": "Close ROM",
        "category": "HackBench"
      },
      {
        "command": "hackbench.openEmulatorPreview",
        "title": "Open Emulator Preview (spike)",
        "category": "HackBench"
      },
      {
        "command": "workbench.actions.treeView.hackbench.mapsExplorer.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "workbench.actions.treeView.hackbench.resourcesExplorer.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "hackbench.openRom",
          "when": "resourceExtname == .sfc || resourceExtname == .smc",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "hackbench.mapEditor",
        "displayName": "HackBench Map Editor",
        "selector": [
          {
            "filenamePattern": "**/*.smwmap"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.paletteEditor",
        "displayName": "HackBench Palette Editor",
        "selector": [
          {
            "filenamePattern": "**/*.smwpalette"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.gfxViewer",
        "displayName": "HackBench GFX Viewer",
        "selector": [
          {
            "filenamePattern": "**/*.smwgfx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.musicPlayer",
        "displayName": "HackBench Music Player",
        "selector": [
          {
            "filenamePattern": "**/*.smwmusic"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.romStats",
        "displayName": "HackBench ROM Statistics",
        "selector": [
          {
            "filenamePattern": "**/*.smwinfo"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.levelGraph",
        "displayName": "HackBench Level Graph",
        "selector": [
          {
            "filenamePattern": "**/*.smwgraph"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.tilesetCompare",
        "displayName": "HackBench Tileset Compare",
        "selector": [
          {
            "filenamePattern": "**/*.smwtilecomp"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.romMap",
        "displayName": "HackBench ROM Map",
        "selector": [
          {
            "filenamePattern": "**/*.smwrommap"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.overworldViewer",
        "displayName": "HackBench Overworld Viewer",
        "selector": [
          {
            "filenamePattern": "**/*.smwoverworld"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hackbenchExplorer",
          "title": "HackBench",
          "icon": "build/icons/icon.svg"
        }
      ]
    },
    "views": {
      "hackbenchExplorer": [
        {
          "id": "hackbench.mapsExplorer",
          "name": "Maps",
          "when": "hackbench.romLoaded"
        },
        {
          "id": "hackbench.resourcesExplorer",
          "name": "Resources",
          "when": "hackbench.romLoaded"
        },
        {
          "id": "hackbench.romExplorerWelcome",
          "name": "HackBench",
          "when": "!hackbench.romLoaded"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hackbench.romExplorerWelcome",
        "contents": "No ROM open.\n[Open ROM…](command:hackbench.openRom)\nOpen a Super Mario World .sfc or .smc file to begin."
      }
    ]
  },
  "scripts": {
    "prepare": "node tools/scripts/set-hooks-path.cjs",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src test tools theia *.js *.mjs --max-warnings 0",
    "lint:fix": "eslint src test tools theia *.js *.mjs --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css}\"",
    "gen:icon": "node tools/scripts/gen-app-icon.mjs",
    "gitnexus": "bash tools/scripts/gitnexus-refresh.sh",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck:theia": "yarn --cwd theia/extension typecheck",
    "capture:render": "npx tsx tools/scripts/render_capture.ts",
    "capture:gate": "npx tsx tools/scripts/capture_gate_cli.ts",
    "perf:core": "node tools/perf/run-core.mjs --out perf-core-results.json",
    "perf:app": "node tools/perf/run-app.mjs --out perf-app-results.json",
    "perf:compare": "node tools/perf/compare.mjs",
    "perf:paired": "node tools/perf/paired.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/codicons": "^0.0.45",
    "cloudevents": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "vscode-uri": "^3.2.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@smwcentral/spc-player": "^2.0.2",
    "@vue/reactivity": "3.5.43"
  }
}
