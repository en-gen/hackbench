{
  "name": "hackbench",
  "displayName": "HackBench",
  "description": "Super Mario World ROM editor for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "engenb",
  "author": "Brian Engen",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "build/icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/en-gen/hackbench"
  },
  "bugs": {
    "url": "https://github.com/en-gen/hackbench/issues"
  },
  "homepage": "https://github.com/en-gen/hackbench#readme",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "hackbench.openRom",
        "title": "Open ROM…",
        "category": "HackBench"
      },
      {
        "command": "hackbench.closeRom",
        "title": "Close ROM",
        "category": "HackBench"
      },
      {
        "command": "workbench.actions.treeView.hackbench.mapsExplorer.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "workbench.actions.treeView.hackbench.resourcesExplorer.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "hackbench.openRom",
          "when": "resourceExtname == .sfc || resourceExtname == .smc",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "hackbench.mapEditor",
        "displayName": "HackBench Map Editor",
        "selector": [
          {
            "filenamePattern": "**/*.smwmap"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.paletteEditor",
        "displayName": "HackBench Palette Editor",
        "selector": [
          {
            "filenamePattern": "**/*.smwpalette"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.gfxViewer",
        "displayName": "HackBench GFX Viewer",
        "selector": [
          {
            "filenamePattern": "**/*.smwgfx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.musicPlayer",
        "displayName": "HackBench Music Player",
        "selector": [
          {
            "filenamePattern": "**/*.smwmusic"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.romStats",
        "displayName": "HackBench ROM Statistics",
        "selector": [
          {
            "filenamePattern": "**/*.smwinfo"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.levelGraph",
        "displayName": "HackBench Level Graph",
        "selector": [
          {
            "filenamePattern": "**/*.smwgraph"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.tilesetCompare",
        "displayName": "HackBench Tileset Compare",
        "selector": [
          {
            "filenamePattern": "**/*.smwtilecomp"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hackbench.romMap",
        "displayName": "HackBench ROM Map",
        "selector": [
          {
            "filenamePattern": "**/*.smwrommap"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hackbenchExplorer",
          "title": "HackBench",
          "icon": "build/icons/icon.svg"
        }
      ]
    },
    "views": {
      "hackbenchExplorer": [
        {
          "id": "hackbench.mapsExplorer",
          "name": "Maps",
          "when": "hackbench.romLoaded"
        },
        {
          "id": "hackbench.resourcesExplorer",
          "name": "Resources",
          "when": "hackbench.romLoaded"
        },
        {
          "id": "hackbench.romExplorerWelcome",
          "name": "HackBench",
          "when": "!hackbench.romLoaded"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hackbench.romExplorerWelcome",
        "contents": "No ROM open.\n[Open ROM…](command:hackbench.openRom)\nOpen a Super Mario World .sfc or .smc file to begin."
      }
    ]
  },
  "scripts": {
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node ./dist-test/test/runTests.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^2.3.8",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.2.1",
    "glob": "^13.0.6",
    "globals": "^17.5.0",
    "mocha": "^11.7.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@smwcentral/spc-player": "^2.0.2",
    "@vue/reactivity": "^3.5.32",
    "pinia": "^3.0.4"
  }
}
