# ROM files and patches — never commit copyrighted or redistributed game files
*.smc
*.sfc
*.rom
*.ips
*.bps

# Test/development ROM hacks (downloaded from SMW Central for local testing).
# The corpus MOVED OUT of the repo, to <projects>/hackbench-tools/roms/, so
# `git clean -x` can no longer delete cartridges that cannot be re-downloaded.
# This rule stays for a clone that has not moved its own copy yet: the
# resolver in test/suite/support/corpus.ts still falls back to test/roms/.
test/roms/
test/magic/

# ROM-DERIVED test fixtures (decompressed GFX, palette dumps, tilemap snapshots,
# SPC audio extracts, etc.) — STRICTLY LOCAL. Nintendo owns this data regardless
# of the transform. Developers regenerate these locally from their own legally
# owned ROM. See docs/testing.md.
test/fixtures/
!test/fixtures/README.md
# lintGate.test.ts scratch dirs (one per run; left behind if a run is killed)
test/suite/gates/__fixtures__/

# Build output
dist/
dist-test/
out/
*.vsix

# Compiled test output written alongside source by tsc (build artifacts)
test/suite/**/*.js
test/suite/**/*.js.map
test/suite/**/*.d.ts

# Mesen's own binaries, Saves/, Debugger/, GameConfig/ and Cheats/ now live in
# <projects>/hackbench-tools/mesen/, outside the repo. These rules still hold
# so an existing clone that kept them in place does not commit them.
# Third-party tools — not redistributable (emulator binaries, proprietary apps)
tools/*
# ...but our own scripts, vendored open-source helpers, and emulator-glue
# scripts stay tracked. Organization:
#   tools/scripts/  — first-party CLI helpers (.ts/.js/.py/.mjs)
#   tools/vendor/   — vendored open-source libraries (each in its own subdir)
#   tools/mesen/    — Mesen integration (*.lua kept, binaries + dumps ignored)
#   tools/perf/     - perf gates: result format, detector, paired runner (#413)
!tools/scripts/
!tools/scripts/**
!tools/vendor/
!tools/vendor/**
!tools/perf/
!tools/perf/**
# The blanket unignores above re-include anything placed inside these
# directories, including a ROM or patch dropped there by accident - so the
# copyright-sensitive extensions at the top of this file are re-ignored
# here, scoped to these two trees, to close that hole.
tools/scripts/**/*.smc
tools/scripts/**/*.sfc
tools/scripts/**/*.rom
tools/scripts/**/*.ips
tools/scripts/**/*.bps
tools/perf/**/*.smc
tools/perf/**/*.sfc
tools/perf/**/*.rom
tools/perf/**/*.ips
tools/perf/**/*.bps
# tools/mesen: unignore the directory first (git cannot re-include files
# when a parent directory remains excluded), then re-ignore everything
# inside except the *.lua scripts and this README.
!tools/mesen/
tools/mesen/*
!tools/mesen/*.lua
!tools/mesen/README.md

# Large binary reference docs (PDFs, scanned pages, OCR intermediates)
docs/*.pdf
docs/book1_pages/
docs/book1_raw.txt
docs/book2.md
docs/book2_raw.txt
docs/book2_cleaned.txt
docs/book2_test.txt

# Disassembled game code — not distributable
docs/disasm/*.asm

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code test runner
.vscode-test/

# Coverage output (vitest/v8)
coverage/
*.lcov

# Local perf-gate run artifacts (#413): `npm run perf:core`'s default --out
# and bisect.mjs's per-commit paired-round file. Both are scratch output, not
# source; a real nightly run writes into hackbench-validation's perf-data
# branch instead.
/perf-core-results.json
/perf-app-results.json
bisect-round.json

# Secrets / local env overrides
.env
.env.*
!.env.example

# Editors
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
.idea/
*.swp

# Build assets that we DO want committed: only build/icons/
build/*
!build/icons
!build/icons/**

# Claude / local agent state; agent roles and shared settings are tracked
.claude/*
!.claude/agents/
!.claude/rules/
!.claude/settings.json

# Python bytecode caches
__pycache__/
*.pyc
.gitnexus

# Playwright e2e output
/test-results/
/playwright-report/

# Spike: libretro core binaries (snes9x, non-commercial license) - never commit
vendor/cores/

# Spike: gameplay screenshots are ROM-derived output - never commit
spike/**/evidence/
spike/**/*.png
spike/**/serve.log

# ROM-derived edit layers (IPS patch files contain ROM bytes)
*.hackbench/
*.hackbench-edits.json

# Theia app: build output and installed dependencies
theia/node_modules/
theia/*/node_modules/
theia/*/lib/
theia/*/src-gen/
theia/*/gen-webpack*.js
theia/browser-app/test-results/
theia/browser-app/screenshots/
theia/*/esbuild.mjs
theia/*/gen-esbuild.*.mjs

# tsc output must never land beside the TypeScript sources
src/**/*.js
src/**/*.d.ts
src/**/*.js.map
src/**/*.d.ts.map
