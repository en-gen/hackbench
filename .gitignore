.DS_Store

# ROM files and patches — never commit copyrighted or redistributed game files
*.smc
*.sfc
*.rom
*.ips
*.bps

# Test/development ROM hacks (downloaded from SMW Central for local testing)
test/roms/

# Build output
dist/
dist-test/
out/
*.vsix

# Compiled test output written alongside source by tsc (build artifacts)
test/suite/**/*.js
test/suite/**/*.js.map
test/suite/**/*.d.ts

# Third-party tools — not redistributable
test/magic/
tools/

# Large binary reference docs (PDFs, scanned pages, OCR intermediates)
docs/*.pdf
docs/book1_pages/
docs/book1_raw.txt
docs/book2_raw.txt
docs/book2_cleaned.txt
docs/book2_test.txt

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code test runner
.vscode-test/

# Misc
.DS_Store
thumbs.db
coverage/
build/*
!build/icons
.claude/
