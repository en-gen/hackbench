{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^ERROR\\s+in\\s+(.*)",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^webpack",
          "endsPattern": "compiled (successfully|with \\d+ error)"
        }
      }
    }
  ]
}
