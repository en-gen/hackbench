{
  "private": true,
  "name": "hackbench-browser-app",
  "version": "0.1.0",
  "description": "HackBench desktop shell, browser target.",
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/workspace": "1.75.0",
    "hackbench-theia-extension": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0"
  },
  "scripts": {
    "bundle": "theia build --mode development",
    "start": "theia start --port 3000 --hostname 127.0.0.1",
    "watch": "theia build --watch --mode development",
    "test:e2e": "playwright test",
    "test:server": "node test/start-test-server.cjs",
    "test:demo": "node test/demo.cjs"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "HackBench"
      }
    }
  }
}
