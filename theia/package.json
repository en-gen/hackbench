{
  "private": true,
  "name": "hackbench-theia",
  "description": "HackBench desktop shell. Monorepo layout per theia-ide.org/docs/composing_applications.",
  "engines": {
    "yarn": ">=1.7.0 <2",
    "node": ">=18"
  },
  "workspaces": [
    "extension",
    "browser-app",
    "electron-app"
  ],
  "scripts": {
    "prepare": "lerna run prepare",
    "build:browser": "yarn --cwd browser-app bundle",
    "start:browser": "yarn --cwd browser-app start",
    "watch:browser": "yarn --cwd browser-app watch",
    "build": "yarn --cwd electron-app bundle",
    "start": "yarn --cwd electron-app start",
    "watch": "yarn --cwd electron-app watch",
    "build:electron": "yarn --cwd electron-app bundle",
    "start:electron": "yarn --cwd electron-app start"
  },
  "devDependencies": {
    "lerna": "^8.0.0"
  },
  "resolutions": {
    "drivelist": "file:./no-native/drivelist",
    "native-keymap": "file:./no-native/native-keymap",
    "@vscode/windows-ca-certs": "file:./no-native/windows-ca-certs",
    "@theia/ffmpeg": "file:./no-native/theia-ffmpeg"
  }
}
