{
  "name": "hackbench-theia-extension",
  "version": "0.1.0",
  "private": true,
  "description": "HackBench as a Theia extension: the SMW editor shell.",
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/electron": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/outline-view": "1.75.0",
    "@theia/workspace": "1.75.0"
  },
  "devDependencies": {
    "typescript": "~5.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "main": "lib/theia/extension/src/common/index.js",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "prepare": "yarn build",
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/theia/extension/src/browser/hackbench-frontend-module",
      "backend": "lib/theia/extension/src/node/hackbench-backend-module"
    },
    {
      "frontend": "lib/theia/extension/src/browser/palette-frontend-module",
      "backend": "lib/theia/extension/src/node/palette-backend-module"
    },
    {
      "frontend": "lib/theia/extension/src/browser/music-frontend-module",
      "backend": "lib/theia/extension/src/node/music-backend-module"
    },
    {
      "frontend": "lib/theia/extension/src/browser/gfx-frontend-module",
      "backend": "lib/theia/extension/src/node/gfx-backend-module"
    },
    {
      "frontend": "lib/theia/extension/src/browser/emulator-frontend-module",
      "frontendElectron": "lib/theia/extension/src/electron-browser/os-locale-electron-frontend-module",
      "electronMain": "lib/theia/extension/src/electron-main/os-locale-main-module",
      "backend": "lib/theia/extension/src/node/emulator-backend-module"
    },
    {
      "frontend": "lib/theia/extension/src/browser/map16-frontend-module",
      "backend": "lib/theia/extension/src/node/map16-backend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ]
}
