#!/usr/bin/env bash
# Enabled by: git config core.hooksPath .githooks
#
# The repo is public: a push is publication, and GitHub keeps refs/pull/*
# copies forever even of force-pushed-away commits. So this has to run
# before push too, not only at commit: a commit made with
# `git commit --no-verify` skips pre-commit, but still gets caught here as
# long as the push itself is not also run with --no-verify (which skips
# every hook, by git's own design - nothing at the hook level can stop
# that; the acceptance criterion here is catching the far more common case
# of a --no-verify'd commit reaching an ordinary push).
#
# git feeds one line per updated ref on stdin:
#   <local ref> <local sha1> <remote ref> <remote sha1>
# See githooks(5).

set -uo pipefail
root="$(git rev-parse --show-toplevel)"
zero='0000000000000000000000000000000000000000'
fail=0

first_pushed_commit_base() {
  # New ref with no shared history to diff against on the remote side yet.
  # Prefer a merge-base with origin/develop (the common case: a feature
  # branch cut from develop); fall back to walking every commit not already
  # on some remote-tracking ref and diffing from the parent of the oldest
  # one (or the empty tree, if it has none - the branch's own first commit).
  local local_sha="$1"
  local base
  base=$(git merge-base "$local_sha" origin/develop 2>/dev/null) && [ -n "$base" ] && {
    echo "$base"
    return 0
  }

  local oldest
  oldest=$(git rev-list "$local_sha" --not --remotes 2>/dev/null | tail -1)
  if [ -z "$oldest" ]; then
    echo "$local_sha"
    return 0
  fi
  base=$(git rev-parse --quiet --verify "$oldest^" 2>/dev/null)
  if [ -z "$base" ]; then
    # Oldest unpushed commit is the repo root: nothing to diff from but empty.
    base=$(git hash-object -t tree /dev/null)
  fi
  echo "$base"
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue # delete: nothing pushed to inspect

  base="$remote_sha"
  [ "$base" = "$zero" ] && base=$(first_pushed_commit_base "$local_sha")

  echo "content gate: checking $local_ref ($base..$local_sha)" >&2
  "$root/tools/scripts/check-staged-content.sh" range "$base" "$local_sha" || fail=1
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Push blocked by tools/scripts/check-staged-content.sh (.githooks/pre-push)." >&2
  echo "Fix the offending commit(s) - amend or rebase. A follow-up removal commit" >&2
  echo "does NOT help once pushed, since GitHub keeps history forever. Ask first" >&2
  echo "before overriding with 'git push --no-verify'." >&2
  exit 1
fi

exit 0
